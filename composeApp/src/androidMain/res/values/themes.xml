<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la app después del splash (Compose dibuja todo lo demás). -->
    <style name="Theme.CoinDen" parent="@android:style/Theme.Material.Light.NoActionBar" />

    <!-- Splash de la marca: fondo #1C140F y el ícono centrado (scripts/brand/export_brand.py). -->
    <style name="Theme.CoinDen.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CoinDen</item>
    </style>
</resources>
